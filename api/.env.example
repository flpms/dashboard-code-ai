# Copy to .env and fill in. Every name here is declared in
# app/config/env.manifest.js — that file is the source of truth, this one is a
# convenience. `npm run env:check` tells you what is missing.

NODE_ENV=development
PORT=3001
LOG_LEVEL=verbose
LOG_PATH=

APP_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

JWT_SECRET=change-me-openssl-rand-base64-48
JWT_EXPIRES_IN=2h

# `localhost` is correct for the documented local flow: Mongo in a container,
# the API on the host via `npm run dev`. When the API itself runs inside the
# compose stack (production), the host is the service name — `mongodb`, not
# localhost. Set the production secret accordingly.
MONGO_CONNECTION=mongodb://root:change-me@localhost:27017/app?authSource=admin
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=change-me
MONGO_INITDB_DATABASE=app

# Set by the deploy; local builds use the image compose builds itself.
API_IMAGE=

USERS_COLLECTION=users
ITEMS_COLLECTION=items
HISTORY_COLLECTION=history

# Optional — leave blank to run without object storage.
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_FILES_BUCKET=
STORAGE_SIGNED_URL_TTL=900
