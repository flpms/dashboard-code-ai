# Optional. Every name has a working default; copy to .env only to change one.
# app/config/env.manifest.js is the source of truth for what each one does.

NODE_ENV=development
PORT=4317
HOST=127.0.0.1
LOG_LEVEL=info
LOG_PATH=

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

DB_PATH=data/events.db

WATCH_DOCKER=true
WATCH_FILES=true
