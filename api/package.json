{
  "name": "@dashboard-code-ai/collector",
  "version": "0.1.0",
  "description": "Local collector: receives Claude Code hooks, docker events and file changes, serves them to the dashboard",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node app/index.js",
    "dev": "node --watch app/index.js",
    "test": "node --test --experimental-test-coverage 'tests/unit/**/*.test.js'",
    "test:watch": "node --test --watch 'tests/unit/**/*.test.js'",
    "test:integration": "node --test 'tests/integration/**/*.spec.js'",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "hooks:install": "node scripts/hooks.js install",
    "hooks:uninstall": "node scripts/hooks.js uninstall",
    "demo": "node scripts/demo-session.js"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/static": "^11.0.0",
    "chalk": "^6.0.0",
    "chokidar": "^6.0.0",
    "dotenv": "^18.0.10",
    "fastify": "^5.12.5",
    "joi": "^18.2.6",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.6"
  }
}
