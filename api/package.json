{
  "name": "@template/api",
  "version": "0.1.0",
  "description": "REST API — layered architecture with manual dependency injection",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node app/index.js",
    "dev": "node --watch app/index.js",
    "test": "node --test --experimental-test-coverage 'tests/unit/**/*.test.js'",
    "test:watch": "node --test --watch 'tests/unit/**/*.test.js'",
    "test:integration": "node --test 'tests/integration/**/*.spec.js'",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "env:render": "node scripts/render-env.js",
    "env:check": "node scripts/check-env.js",
    "seed:admin": "node scripts/seed-admin.js",
    "audit:prod": "npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1124.0",
    "@aws-sdk/s3-request-presigner": "^3.1124.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "chalk": "^6.0.0",
    "dotenv": "^18.0.10",
    "fastify": "^5.12.5",
    "joi": "^18.2.6",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^7.6.0",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.6"
  }
}
